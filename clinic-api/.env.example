# =============================================
# MediCare Clinic API — Environment Variables
# =============================================
# Sao chép file này thành .env và điền giá trị thực

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL via Docker) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=medicare_user
DB_PASSWORD=medicare_pass_2024
DB_NAME=medicare_db
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false
DB_SSL_CA_FILE=
DB_POOL_MAX=5

# Supabase: replace DB_HOST/DB_USERNAME with Connect > Session pooler values.
# DB_HOST=<host from Connect, not the https project URL>
# DB_PORT=5432
# DB_USERNAME=postgres.<project-reference>
# DB_PASSWORD="<database password, not an API key>"
# DB_NAME=postgres
# DB_SSL=true
# DB_SSL_CA_FILE=C:/path/to/downloaded-certificate.crt

# --- JWT Authentication ---
JWT_SECRET=medicare_super_secret_key_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=medicare_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- Bcrypt ---
BCRYPT_ROUNDS=12

# --- API ---
API_PREFIX=/api/v1
